    Main -> AdaptadorFedEx : enviarPaquete("Madrid, España", 2.5)
    activate AdaptadorFedEx
    AdaptadorFedEx -> AdaptadorFedEx : convertir kg a lbs (2.5 * 2.20462)
    AdaptadorFedEx -> SistemaFedEx : sendShipment("Madrid, España", 5.51)
    activate SistemaFedEx
    SistemaFedEx --> AdaptadorFedEx : paquete enviado
    deactivate SistemaFedEx
    AdaptadorFedEx --> Main : confirmación
    deactivate AdaptadorFedEx

    Main -> AdaptadorFedEx : calcularCosto("Madrid, España", 2.5)
    activate AdaptadorFedEx
