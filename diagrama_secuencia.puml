    deactivate AdaptadorDHL

    Main -> AdaptadorDHL : enviarPaquete("Madrid, España", 2.5)
    activate AdaptadorDHL
    AdaptadorDHL -> AdaptadorDHL : convertir peso (kg)
    AdaptadorDHL -> SistemaDHL : shipPackage("Madrid, España", 2.5)
    activate SistemaDHL
    SistemaDHL --> AdaptadorDHL : paquete enviado
    deactivate SistemaDHL
    AdaptadorDHL --> Main : confirmación
    deactivate AdaptadorDHL

    Main -> AdaptadorDHL : calcularCosto("Madrid, España", 2.5)
    activate AdaptadorDHL
    AdaptadorDHL -> SistemaDHL : calculateShippingPrice(2.5, "Madrid")
    activate SistemaDHL
    SistemaDHL --> AdaptadorDHL : precio
    deactivate SistemaDHL
    AdaptadorDHL --> Main : $13.00
    deactivate AdaptadorDHL

    Main -> AdaptadorDHL : obtenerEstado()
