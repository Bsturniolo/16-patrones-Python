group Validar Pedido 1
    Main -> ValidadorStock : validar(pedido1)
    activate ValidadorStock
    ValidadorStock -> ValidadorStock : verificar stock
    ValidadorStock -> ValidadorDireccion : validarSiguiente(pedido1)
    activate ValidadorDireccion
    ValidadorDireccion -> ValidadorDireccion : verificar dirección
    ValidadorDireccion -> ValidadorMonto : validarSiguiente(pedido1)
    activate ValidadorMonto
    ValidadorMonto -> ValidadorMonto : verificar monto ($10-$5000)
    ValidadorMonto -> ValidadorPago : validarSiguiente(pedido1)
    activate ValidadorPago
    ValidadorPago -> ValidadorPago : verificar método de pago
    ValidadorPago --> ValidadorMonto : true
    deactivate ValidadorPago
    ValidadorMonto --> ValidadorDireccion : true
    deactivate ValidadorMonto
    ValidadorDireccion --> ValidadorStock : true
    deactivate ValidadorDireccion
    ValidadorStock --> Main : true (PEDIDO VALIDADO)
    deactivate ValidadorStock
    note right: Todos los validadores\naprobaron el pedido
end

