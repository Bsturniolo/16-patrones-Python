== 12. PATRÓN STATE - Gestión de Estados del Pedido ==

group Crear Pedido y Transiciones
    Main -> PedidoCtx : new PedidoContext("ORD-STATE-001", 899.99)
    activate PedidoCtx
    PedidoCtx -> EstadoNuevo : new EstadoNuevo()
    activate EstadoNuevo
    EstadoNuevo --> PedidoCtx : estadoInicial
    deactivate EstadoNuevo
    PedidoCtx --> Main : pedido (estado: NUEVO)
    deactivate PedidoCtx

    Main -> PedidoCtx : mostrarEstado()
    activate PedidoCtx
    PedidoCtx -> EstadoNuevo : mostrarEstado()
    activate EstadoNuevo
    EstadoNuevo --> PedidoCtx : "🆕 NUEVO - Pedido recibido"
    deactivate EstadoNuevo
    PedidoCtx --> Main : estado mostrado
    deactivate PedidoCtx

    Main -> PedidoCtx : avanzar()
    activate PedidoCtx
    PedidoCtx -> EstadoNuevo : siguiente(context)
    activate EstadoNuevo
    EstadoNuevo -> EstadoConfirmado : new EstadoConfirmado()
    activate EstadoConfirmado
    EstadoConfirmado --> EstadoNuevo : nuevo estado
    deactivate EstadoConfirmado
    EstadoNuevo -> PedidoCtx : setEstado(confirmado)
    EstadoNuevo --> PedidoCtx : transición completada
    deactivate EstadoNuevo
    PedidoCtx --> Main : estado cambiado a CONFIRMADO
    deactivate PedidoCtx

    Main -> PedidoCtx : mostrarEstado()
    activate PedidoCtx
    PedidoCtx -> EstadoConfirmado : mostrarEstado()
    activate EstadoConfirmado
    EstadoConfirmado --> PedidoCtx : "✓ CONFIRMADO - En proceso de pago"
    deactivate EstadoConfirmado
    PedidoCtx --> Main : estado mostrado
    deactivate PedidoCtx

    Main -> PedidoCtx : avanzar()
    activate PedidoCtx
    PedidoCtx -> EstadoConfirmado : siguiente(context)
    activate EstadoConfirmado
    EstadoConfirmado -> EstadoEnviado : new EstadoEnviado()
    activate EstadoEnviado
    EstadoEnviado --> EstadoConfirmado : nuevo estado
    deactivate EstadoEnviado
    EstadoConfirmado -> PedidoCtx : setEstado(enviado)
    EstadoConfirmado --> PedidoCtx : transición completada
    deactivate EstadoConfirmado
    PedidoCtx --> Main : estado cambiado a ENVIADO
    deactivate PedidoCtx

    Main -> PedidoCtx : avanzar()
    activate PedidoCtx
    PedidoCtx -> EstadoEnviado : siguiente(context)
    activate EstadoEnviado
    EstadoEnviado -> EstadoEntregado : new EstadoEntregado()
    activate EstadoEntregado
    EstadoEntregado --> EstadoEnviado : nuevo estado
    deactivate EstadoEntregado
    EstadoEnviado -> PedidoCtx : setEstado(entregado)
    EstadoEnviado --> PedidoCtx : transición completada
    deactivate EstadoEnviado
    PedidoCtx --> Main : estado cambiado a ENTREGADO
    deactivate PedidoCtx
    note right: Flujo exitoso:\nNUEVO → CONFIRMADO\n→ ENVIADO → ENTREGADO
end

group Cancelar Pedido Nuevo
    Main -> PedidoCtx : new PedidoContext("ORD-STATE-002", 500.00)
    activate PedidoCtx
    PedidoCtx --> Main : pedido2 (NUEVO)
    deactivate PedidoCtx

    Main -> PedidoCtx : cancelar()
    activate PedidoCtx
    PedidoCtx -> EstadoNuevo : cancelar(context)
    activate EstadoNuevo
    EstadoNuevo -> EstadoCancelado : new EstadoCancelado()
    activate EstadoCancelado
    EstadoCancelado --> EstadoNuevo : estado cancelado
    deactivate EstadoCancelado
    EstadoNuevo -> PedidoCtx : setEstado(cancelado)
    EstadoNuevo --> PedidoCtx : "Pedido cancelado (inmediato)"
    deactivate EstadoNuevo
    PedidoCtx --> Main : pedido cancelado
    deactivate PedidoCtx
    note right: Cancelación inmediata\ndesde estado NUEVO
end

group Intentar Cancelar Pedido Enviado
    Main -> PedidoCtx : new PedidoContext("ORD-STATE-003", 300.00)
    activate PedidoCtx
    PedidoCtx --> Main : pedido3 (NUEVO)
    deactivate PedidoCtx

    Main -> PedidoCtx : avanzar()
    activate PedidoCtx
    PedidoCtx --> Main : CONFIRMADO
    deactivate PedidoCtx

    Main -> PedidoCtx : avanzar()
    activate PedidoCtx
    PedidoCtx --> Main : ENVIADO
    deactivate PedidoCtx

    Main -> PedidoCtx : cancelar()
    activate PedidoCtx
    PedidoCtx -> EstadoEnviado : cancelar(context)
    activate EstadoEnviado
    EstadoEnviado --> PedidoCtx : "No se puede cancelar: ya enviado"
    deactivate EstadoEnviado
    PedidoCtx --> Main : cancelación rechazada
    deactivate PedidoCtx
    note right: Estados ENVIADO y ENTREGADO\nno permiten cancelación
end

Main --> Usuario : FIN DE DEMOSTRACIÓN\n12 PATRONES IMPLEMENTADOS
deactivate Main

