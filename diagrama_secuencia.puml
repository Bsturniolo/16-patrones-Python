== 9. PATRÓN PROTOTYPE - Clonar Productos ==

group Obtener Registro Singleton
    Main -> RegistroPrototipos : getInstance()
    activate RegistroPrototipos
    RegistroPrototipos -> RegistroPrototipos : crear instancia (si no existe)
    RegistroPrototipos --> Main : registro
    deactivate RegistroPrototipos
end

group Clonar Producto Laptop
    Main -> RegistroPrototipos : obtenerPrototipo("laptop")
    activate RegistroPrototipos
    RegistroPrototipos -> ProductoPrototype1 : clonar()
    activate ProductoPrototype1
    ProductoPrototype1 -> ProductoPrototype1 : copy constructor (deep copy)
    ProductoPrototype1 --> RegistroPrototipos : laptop1 (clon)
    deactivate ProductoPrototype1
    RegistroPrototipos --> Main : laptop1
    deactivate RegistroPrototipos

    Main -> ProductoPrototype1 : setNombre("Laptop Gaming")
    activate ProductoPrototype1
    ProductoPrototype1 --> Main : nombre actualizado
    deactivate ProductoPrototype1

    Main -> ProductoPrototype1 : setPrecio(1299.99)
    activate ProductoPrototype1
    ProductoPrototype1 --> Main : precio actualizado
    deactivate ProductoPrototype1

    Main -> ProductoPrototype1 : agregarEspecificacion("GPU", "RTX 4060")
    activate ProductoPrototype1
    ProductoPrototype1 --> Main : especificación agregada
    deactivate ProductoPrototype1

    Main -> ProductoPrototype1 : mostrarInfo()
    activate ProductoPrototype1
    ProductoPrototype1 --> Main : info completa
    deactivate ProductoPrototype1
end

group Clonar Otro Producto Laptop
    Main -> RegistroPrototipos : obtenerPrototipo("laptop")
    activate RegistroPrototipos
    RegistroPrototipos -> ProductoPrototype2 : clonar()
    activate ProductoPrototype2
    ProductoPrototype2 -> ProductoPrototype2 : copy constructor
    ProductoPrototype2 --> RegistroPrototipos : laptop2 (clon independiente)
    deactivate ProductoPrototype2
    RegistroPrototipos --> Main : laptop2
    deactivate RegistroPrototipos

    Main -> ProductoPrototype2 : setNombre("Laptop Oficina")
    activate ProductoPrototype2
    ProductoPrototype2 --> Main : nombre diferente
    deactivate ProductoPrototype2

    Main -> ProductoPrototype2 : mostrarInfo()
    activate ProductoPrototype2
    ProductoPrototype2 --> Main : info diferente
    deactivate ProductoPrototype2
    note right: laptop1 y laptop2 son\nclones independientes\nModificar uno no afecta al otro
end

